__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.so
.env
.venv/
venv/
.idea/
uv.lock

# generated benchmark inputs (regenerated deterministically from bench/cases.py;
# the results JSONL under bench/results/ *is* tracked — that is the provenance)
# ...except an A/B run's scratch samples, which describe one laptop for one
# afternoon and answer a question that is over once it is answered.
bench/results/ab/
bench/.cache/
# pytest-benchmark's run store; baselines to compare against are chosen by
# number at the command line, not committed
.benchmarks/

# spike outputs (scripts are tracked; data/LP artifacts are not)
scratch/relational_spike/*_data/
scratch/relational_spike/bench_out/
scratch/relational_spike/*.lp
.DS_Store

# the built site (`mkdocs build`); Read the Docs builds it from source
site/
# mkdocs-jupyter's store of executed notebooks, keyed by content, so a local
# rebuild does not re-run one that did not change
.cache/

# rendered presentation output (sources docs/*.md + docs/*.svg are tracked)
docs/*.html
docs/*.pdf
# ...except the chart page, which is a source: it carries the numbers inline
# and is what docs/benchmarks.md links to.
!docs/benchmarks-scaling.html
